# Where phones reach the relay — baked into pairing QR codes.
# LAN example:    http://192.168.1.20:8787
# Domain example: https://relay.example.com
RELAY_PUBLIC_URL=

# Only for `docker compose --profile tls up -d`
RELAY_DOMAIN=

# Host port for the plain-HTTP relay (default 8787).
# With the tls profile set it to 127.0.0.1:8787 so only Caddy (HTTPS) is
# reachable from outside.
RELAY_HTTP_PORT=8787

# Optional: Firebase service-account JSON for push notifications to Android +
# iOS. Copy it into the volume first:
#   docker compose cp firebase.json relay:/data/firebase.json
# then set:
RELAY_FCM_SERVICE_ACCOUNT=
